<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_sprint_view_list" model="ir.ui.view">
        <field name="name">project.sprint.list</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_points"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-success="state == 'active'"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="project_sprint_view_form" model="ir.ui.view">
        <field name="name">project.sprint.form</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Iniciar sprint"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_close" type="object" string="Fechar sprint"
                            class="btn-primary" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <field name="is_overdue" invisible="1"/>
                    <widget name="web_ribbon" title="Atrasado" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'closed'"/>
                            <field name="project_id" readonly="state != 'planned'"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state == 'closed'"/>
                            <field name="date_end" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <group string="Progresso">
                        <group>
                            <field name="progress" widget="progressbar"/>
                            <field name="task_count"/>
                        </group>
                        <group>
                            <field name="total_points"/>
                            <field name="done_points"/>
                        </group>
                    </group>
                    <field name="goal" placeholder="Objetivo do sprint..."
                           readonly="state == 'closed'"/>
                    <notebook>
                        <page string="Tarefas">
                            <field name="task_ids"
                                   domain="[('project_id', '=', project_id)]"
                                   readonly="state == 'closed'">
                                <list>
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="effort_points"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_sprint_view_search" model="ir.ui.view">
        <field name="name">project.sprint.search</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="filter_planned" string="Planeados"
                        domain="[('state', '=', 'planned')]"/>
                <filter name="filter_running" string="Ativos"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_closed" string="Fechados"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_overdue" string="Atrasados"
                        domain="[('state', '=', 'active'), ('date_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_project" string="Projeto"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="project_sprint_action" model="ir.actions.act_window">
        <field name="name">Sprints</field>
        <field name="res_model">project.sprint</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="project_sprint_menu" name="Sprints"
              parent="project.menu_main_pm" action="project_sprint_action"
              sequence="15"/>
</odoo>
