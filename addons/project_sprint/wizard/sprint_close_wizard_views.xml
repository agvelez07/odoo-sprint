<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_sprint_close_wizard_view_form" model="ir.ui.view">
        <field name="name">project.sprint.close.wizard.form</field>
        <field name="model">project.sprint.close.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="sprint_id" invisible="1"/>
                <field name="project_id" invisible="1"/>
                <p>Há tarefas por concluir neste sprint. O que fazer com elas?</p>
                <field name="open_task_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="stage_id"/>
                        <field name="effort_points"/>
                    </list>
                </field>
                <group>
                    <field name="destination" widget="radio"/>
                    <field name="next_sprint_id"
                           invisible="destination != 'next'"
                           required="destination == 'next'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Fechar sprint"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
