<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Todos os dias avisa a equipa dos sprints que terminam amanhã
         ou que acabaram de ficar em atraso. -->
    <record id="cron_sprint_deadline_alerts" model="ir.cron">
        <field name="name">Sprints: alertas de prazo</field>
        <field name="model_id" ref="model_project_sprint"/>
        <field name="state">code</field>
        <field name="code">model._cron_deadline_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
