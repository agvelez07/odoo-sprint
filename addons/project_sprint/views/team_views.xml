<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_team_view_list" model="ir.ui.view">
        <field name="name">project.team.list</field>
        <field name="model">project.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Equipa"/>
                <field name="lead_id" widget="many2one_avatar_user"/>
                <field name="project_count" string="Projetos"/>
                <field name="sprint_active_count" string="A decorrer"/>
                <field name="sprint_overdue_count" string="Em atraso"
                       decoration-danger="sprint_overdue_count > 0"/>
                <field name="member_count" string="Membros"/>
            </list>
        </field>
    </record>

    <record id="project_team_view_form" model="ir.ui.view">
        <field name="name">project.team.form</field>
        <field name="model">project.team</field>
        <field name="arch" type="xml">
            <form class="o_sprint_form">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nome da equipa"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id" widget="many2one_avatar_user"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="sprint_active_count" string="Sprints a decorrer"/>
                            <field name="sprint_overdue_count" string="Sprints em atraso"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Membros">
                            <field name="member_ids">
                                <list>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="role_id"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="user_id" domain="[('share', '=', False)]"
                                               options="{'no_create': True}"/>
                                        <field name="role_id"/>
                                    </group>
                                    <separator string="Tarefas em sprints (por prazo)"/>
                                    <field name="task_ids" readonly="1">
                                        <list decoration-danger="days_overdue > 0">
                                            <field name="name"/>
                                            <field name="project_id"/>
                                            <field name="current_sprint_id"/>
                                            <field name="stage_id"/>
                                            <field name="date_deadline" string="Prazo"/>
                                            <field name="deadline_status" string="Situação"/>
                                            <field name="days_overdue" column_invisible="1"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Projetos e sprints">
                            <separator string="Projetos"/>
                            <field name="project_ids" readonly="1">
                                <list><field name="name"/></list>
                            </field>
                            <separator string="Sprints"/>
                                <field name="sprint_ids" readonly="1"
                                   context="{'list_view_ref': 'project_sprint.project_sprint_view_list'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_team_action" model="ir.actions.act_window">
        <field name="name">Equipas</field>
        <field name="res_model">project.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="project_team_role_view_list" model="ir.ui.view">
        <field name="name">project.team.role.list</field>
        <field name="model">project.team.role</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="project_team_role_action" model="ir.actions.act_window">
        <field name="name">Funções</field>
        <field name="res_model">project.team.role</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="project_team_menu" name="Equipas"
              parent="project_sprint_root_menu" action="project_team_action"
              sequence="20"/>
    <menuitem id="project_team_role_menu" name="Funções"
              parent="project_sprint_root_menu" action="project_team_role_action"
              sequence="30"/>
</odoo>