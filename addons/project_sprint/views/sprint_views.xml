<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_sprint_view_list" model="ir.ui.view">
        <field name="name">project.sprint.list</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="milestone_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="deadline_status" string="Prazo"/>
                <field name="total_points"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-success="state == 'active'"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="project_sprint_view_kanban" model="ir.ui.view">
        <field name="name">project.sprint.kanban</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <!-- As mudanças de estado fazem-se com os botões do sprint (Iniciar/Fechar) -->
            <kanban default_group_by="state" records_draggable="false"
                    group_create="false" group_edit="false" group_delete="false"
                    quick_create="false" class="o_kanban_small_column">
                <field name="is_overdue"/>
                <field name="milestone_at_risk"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="name" class="fw-bold fs-5"/>
                            <span t-if="record.is_overdue.raw_value" class="badge text-bg-danger">Atrasado</span>
                        </div>
                        <field name="project_id" class="text-muted"/>
                        <field name="progress" widget="progressbar" class="my-2"/>
                        <div class="d-flex justify-content-between text-muted">
                            <field name="deadline_status"/>
                            <span><field name="done_points"/> / <field name="total_points"/> pts</span>
                        </div>
                        <footer class="pt-2">
                            <field name="milestone_id" t-if="record.milestone_id.raw_value"
                                   t-att-class="record.milestone_at_risk.raw_value ? 'text-warning' : 'text-muted'"/>
                            <a type="object" name="action_open_board" class="ms-auto">
                                <i class="fa fa-columns me-1"/>Board
                            </a>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="project_sprint_view_graph" model="ir.ui.view">
        <field name="name">project.sprint.graph</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <graph string="Pontos por projeto" type="bar">
                <field name="project_id"/>
                <field name="total_points" type="measure"/>
                <field name="done_points" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="project_sprint_view_form" model="ir.ui.view">
        <field name="name">project.sprint.form</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <form class="o_sprint_form">
                <header>
                    <button name="action_start" type="object" string="Iniciar sprint"
                            class="btn-primary" invisible="state != 'planned'"
                            groups="project_sprint.group_team_lead,project.group_project_manager"/>
                    <button name="action_close" type="object" string="Fechar sprint"
                            class="btn-primary" invisible="state != 'active'"
                            groups="project_sprint.group_team_lead,project.group_project_manager"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_board" type="object"
                                class="oe_stat_button" icon="fa-columns">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="task_count"/></span>
                                <span class="o_stat_text">Board</span>
                            </div>
                        </button>
                    </div>
                    <field name="is_overdue" invisible="1"/>
                    <widget name="web_ribbon" title="Atrasado" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome do sprint"
                                   readonly="state == 'closed'"/>
                        </h1>
                        <h3>
                            <field name="goal" placeholder="Objetivo do sprint..."
                                   readonly="state == 'closed'"/>
                        </h3>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not milestone_at_risk">
                        Este sprint termina depois do prazo do milestone
                        (<field name="milestone_deadline" class="oe_inline"/>).
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'planned'"
                                   domain="[('team_id', '!=', False)]"/>
                            <field name="team_id"/>
                            <field name="milestone_id" readonly="state == 'closed'"
                                   options="{'no_create': True}"/>
                            <field name="milestone_at_risk" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state == 'closed'"/>
                            <field name="date_end" readonly="state == 'closed'"/>
                            <field name="deadline_status" string="Prazo"/>
                        </group>
                    </group>
                    <group string="Progresso">
                        <group>
                            <field name="progress" widget="progressbar"/>
                            <field name="task_count"/>
                        </group>
                        <group>
                            <field name="total_points"/>
                            <field name="done_points"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tarefas">
                            <field name="task_ids"
                                   domain="[('project_id', '=', project_id)]"
                                   context="{'sprint_id': id}"
                                   options="{'unlink': false, 'no_create': true}"
                                   readonly="state == 'closed'">
                                <list decoration-danger="days_overdue > 0">
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="stage_id"/>
                                    <field name="effort_points" string="Pontos"/>
                                    <field name="date_deadline" string="Prazo"
                                           options="{'show_time': false}"/>
                                    <field name="deadline_status" string="Situação"/>
                                    <field name="days_overdue" column_invisible="1"/>
                                    <button name="action_remove_from_sprint" type="object"
                                            icon="fa-times" title="Remover do sprint"
                                            groups="project_sprint.group_team_lead,project.group_project_manager"
                                            confirm="Tem a certeza que quer remover esta tarefa do sprint? A tarefa não é apagada: continua no projeto."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="project_sprint_view_search" model="ir.ui.view">
        <field name="name">project.sprint.search</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <filter name="filter_planned" string="Planeados"
                        domain="[('state', '=', 'planned')]"/>
                <filter name="filter_running" string="Ativos"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_closed" string="Fechados"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_overdue" string="Atrasados"
                        domain="[('state', '=', 'active'), ('date_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_project" string="Projeto"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="project_id" string="Projetos" icon="fa-folder"
                           select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="project_sprint_action" model="ir.actions.act_window">
        <field name="name">Sprints</field>
        <field name="res_model">project.sprint</field>
        <field name="view_mode">list,kanban,form,graph</field>
    </record>

    <menuitem id="project_sprint_root_menu" name="Sprints"
              web_icon="project_sprint,static/description/icon.png"
              sequence="30"/>

    <menuitem id="project_sprint_menu" name="Sprints"
              parent="project_sprint_root_menu" action="project_sprint_action"
              sequence="10"/>
</odoo>